FROM golang:1.25-alpine AS go
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/agent ./cmd/agent

FROM alpine:3.22
ARG TARGETARCH
ARG XRAY_VERSION=v26.3.27
RUN apk add --no-cache ca-certificates tzdata curl unzip
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) asset=Xray-linux-64.zip; sha=23cd9af937744d97776ee35ecad4972cf4b2109d1e0fe6be9930467608f7c8ae;; \
      arm64) asset=Xray-linux-arm64-v8a.zip; sha=4d30283ae614e3057f730f67cd088a42be6fdf91f8639d82cb69e48cde80413c;; \
      *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1;; \
    esac; \
    curl -fsSL --retry 3 "https://github.com/XTLS/Xray-core/releases/download/${XRAY_VERSION}/${asset}" -o /tmp/xray.zip; \
    echo "$sha  /tmp/xray.zip" | sha256sum -c -; \
    mkdir -p /usr/local/share/xray /data; \
    unzip -q /tmp/xray.zip -d /usr/local/share/xray; \
    install -m 0755 /usr/local/share/xray/xray /usr/local/bin/xray; \
    rm -f /tmp/xray.zip
COPY --from=go /out/agent /usr/local/bin/agent
ENV DATA_DIR=/data XRAY_BIN=/usr/local/bin/xray XRAY_LOCATION_ASSET=/usr/local/share/xray
VOLUME ["/data"]
CMD ["/usr/local/bin/agent"]
