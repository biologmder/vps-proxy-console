FROM node:24-alpine AS web
WORKDIR /src/web
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM golang:1.25-alpine AS go
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/panel ./cmd/panel

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata && addgroup -S app && adduser -S app -G app && mkdir -p /data /app/web && chown app:app /data
COPY --from=go /out/panel /usr/local/bin/panel
COPY --from=web /src/web/dist /app/web
USER app
ENV DATABASE_PATH=/data/panel.db WEB_DIR=/app/web LISTEN_ADDR=:8080
EXPOSE 8080
CMD ["/usr/local/bin/panel"]
